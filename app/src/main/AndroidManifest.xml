<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.m3man">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- M62：targetSdk=28 + requestLegacyExternalStorage 下，API 29~32 设备仍走 legacy 存储模型，
         写 /sdcard/3mman/video 必须持有 WRITE_EXTERNAL_STORAGE；maxSdkVersion 从 28 提到 32，
         否则 Android 10~12 设备该权限在合并 manifest 中不存在、运行时请求被静默拒绝 -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- M20：API33+ 细分媒体权限，读取本地已下载视频/封面需要 -->
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- 允许读取手机状态 用于创建BmobInstallation -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- 获取wifi网络状态的信息 -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- 保持CPU 运转，屏幕和键盘灯有可能是关闭的,用于文件上传和下载 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- M23：API33+ 通知需要运行时授权，否则下载/升级进度通知静默不显示 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application
        android:name=".MyApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/AppTheme"
        tools:ignore="GoogleAppIndexingWarning"
        tools:replace="android:allowBackup"
        tools:targetApi="n"
        android:requestLegacyExternalStorage="true">
        <activity
            android:name=".ui.main.MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode|keyboard|layoutDirection">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.download.DownloadActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode|keyboard|layoutDirection"
            android:label="@string/my_download"
            android:launchMode="singleTop"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.mman9video.favorite.FavoriteActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode|keyboard|layoutDirection"
            android:label="@string/my_collect"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.mman9video.favorite.PornyFavoriteActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode|keyboard|layoutDirection"
            android:label="@string/porny_local_favorite"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.mman9video.user.UserLoginActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode|keyboard|layoutDirection"
            android:label="@string/title_user_login"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.mman9video.user.UserRegisterActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode|keyboard|layoutDirection"
            android:label="@string/title_user_register"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.upload.UploadVideoActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode|keyboard|layoutDirection"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.mman9video.history.HistoryActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode|keyboard|layoutDirection"
            android:label="@string/history_views"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.about.AboutActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode|keyboard|layoutDirection"
            android:label="@string/about_me"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.mman9video.play.ExoMediaPlayerActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode|keyboard|layoutDirection"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustPan" />
        <activity
            android:name=".ui.mman9video.play.JiaoZiVideoPlayerActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode|keyboard|layoutDirection"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustPan" />
        <activity
            android:name=".ui.mman9video.search.SearchActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode|keyboard|layoutDirection"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.mman9video.search.SearchPornyActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode|keyboard|layoutDirection"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.mman9video.author.AuthorActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode|keyboard|layoutDirection"
            android:label="@string/title_author_video"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.mman9video.author.AuthorFavoriteActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode|keyboard|layoutDirection"
            android:label="@string/author_favorite"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.recommend.RecommendFeedActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode|keyboard|layoutDirection"
            android:label="@string/title_recommend"
            android:windowSoftInputMode="adjustPan" />
        <activity
            android:name=".ui.update.UpdateActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode|keyboard|layoutDirection"
            android:exported="false"
            android:label="@string/title_update"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustPan" />
        <activity
            android:name=".ui.setting.SettingActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode|keyboard|layoutDirection"
            android:label="@string/title_setting"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ui.proxy.ProxySettingActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode|keyboard|layoutDirection"
            android:label="@string/activity_proxy_setting"
            android:screenOrientation="portrait" />
        <!-- M31：API34 起前台服务必须声明 foregroundServiceType，否则启动被系统阻断 -->
        <service
            android:name=".service.UpdateDownloadService"
            android:foregroundServiceType="dataSync" />
        <service
            android:name=".service.DownloadVideoService"
            android:foregroundServiceType="dataSync" />
        <service
            android:name=".service.HlsDownloadService"
            android:foregroundServiceType="dataSync" />

        <provider
            android:name="android.support.v4.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/filepaths" />
        </provider>

        <meta-data
            android:name="android.max_aspect"
            android:value="2.1" />

    </application>

</manifest>