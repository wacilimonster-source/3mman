<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- M119：第一页下拉换一批（SwipeRefreshLayout 仅在顶部时拦截下拉，与翻页/播放手势无冲突） -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh_recommend"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView_recommend"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- M78：右上角方向筛选胶囊 -->
    <ImageView
        android:id="@+id/iv_reco_landscape_back"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|start"
        android:layout_marginLeft="6dp"
        android:layout_marginStart="6dp"
        android:layout_marginTop="6dp"
        android:contentDescription="@string/reco_back"
        android:padding="8dp"
        android:src="@drawable/ic_arrow_back_white_32dp"
        android:visibility="gone" />

    <!-- M118：右上角筛选/开关组合（方向筛选 + 时长筛选 + 自动连播）。
         状态栏避让由 applyTopBarInsets 统一调本容器 topMargin。 -->
    <LinearLayout
        android:id="@+id/ll_reco_top_filters"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginRight="14dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_reco_orientation_filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#66000000"
            android:paddingBottom="5dp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingTop="5dp"
            android:text="@string/reco_filter_all"
            android:textColor="#CCFFFFFF"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tv_reco_duration_filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginStart="8dp"
            android:background="#66000000"
            android:paddingBottom="5dp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingTop="5dp"
            android:text="@string/reco_duration_all"
            android:textColor="#CCFFFFFF"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tv_reco_auto_next"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginStart="8dp"
            android:background="#66000000"
            android:paddingBottom="5dp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingTop="5dp"
            android:text="@string/reco_auto_next_on"
            android:textColor="#CCFFFFFF"
            android:textSize="13sp" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/pb_recommend_loading"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_gravity="center" />

    <LinearLayout
        android:id="@+id/ll_recommend_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_recommend_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/reco_empty"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btn_recommend_retry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/reco_retry" />

        <!-- M119：方向/时长筛选把池子筛空时的一键恢复入口 -->
        <Button
            android:id="@+id/btn_recommend_reset_filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/reco_reset_filters"
            android:visibility="gone" />
    </LinearLayout>

    <!-- M119：新手手势/操作引导浮层（仅首次进入推荐页显示，点击任意处关闭） -->
    <LinearLayout
        android:id="@+id/ll_reco_guide"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/reco_guide_title"
            android:textColor="#FFFFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:lineSpacingExtra="8dp"
            android:text="@string/reco_guide_lines"
            android:textColor="#E6FFFFFF"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/reco_guide_dismiss"
            android:textColor="#99FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
