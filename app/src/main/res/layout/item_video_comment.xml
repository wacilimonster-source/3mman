<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/item_background"
    android:padding="2dp"
    android:orientation="vertical">

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_item_video_comment_title_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lines="1"
        android:textColor="@color/item_3mman_comment_info_text_color"
        android:textSize="13sp"
        android:text="@string/comment_layout_sample"
        />

    <TextView
        android:id="@+id/tv_item_video_comment_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:paddingLeft="3dp"
        android:textStyle="bold"
        android:textAppearance="@style/TextAppearance.App.Title"
        android:textColor="@color/item_3mman_comment_message_text_color"
        android:text="@string/comment_layout_sample2"
        />
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_item_video_comment_replytime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lines="1"
        android:gravity="right"
        android:textAppearance="@style/TextAppearance.App.Caption"
        android:textColor="@color/item_3mman_comment_info_text_color"
        android:text="@string/comment_layout_time"
        />
</LinearLayout>