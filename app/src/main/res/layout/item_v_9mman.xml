<?xml version="1.0" encoding="utf-8"?>
<!-- M112 重构（原结构 CardView > LinearLayout > ConstraintLayout > ImageView，4 层）：
     1. 原 CardView 的 cardCornerRadius=0dp、无 margin、contentPadding 仅 1dp —— 它只当
        「纯 padding 壳」用，却多出一层背景导致过度绘制，且 minSdk 28 下
        cardUseCompatPadding 也不产生任何间距，故整个 CardView 层删除；
     2. 原中间的 ConstraintLayout 只包了一个 ImageView，同样合并；
     3. scaleType 由 fitCenter 改为 centerCrop：16:9 约束下非 16:9 封面原来会留黑边。
     id 保持不变（iv_91mman_item_img / tv_91mman_item_title / tv_91mman_item_info），
     V91MmanAdapter / V9MmanItemAdapter / DownloadVideoAdapter 及右滑菜单 include 均不受影响。 -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/recycler_item_selector">

    <ImageView
        android:id="@+id/iv_91mman_item_img"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:transitionName="video_cover"
        app:layout_constraintDimensionRatio="H,16:9"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"  android:contentDescription="@string/cd_video_cover"/>

    <!-- M119：视频方向角标（竖屏/横屏），源图宽高比由 SmartCoverTransformation 登记后回读 -->
    <TextView
        android:id="@+id/tv_orientation_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="6dp"
        android:layout_marginRight="6dp"
        android:background="#66000000"
        android:paddingBottom="2dp"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:paddingTop="2dp"
        android:textColor="#E6FFFFFF"
        android:textSize="10sp"
        android:visibility="gone"
        app:layout_constraintRight_toRightOf="@id/iv_91mman_item_img"
        app:layout_constraintTop_toTopOf="@id/iv_91mman_item_img" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_91mman_item_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:maxLines="2"
        android:minHeight="42dp"
        android:paddingLeft="6dp"
        android:paddingTop="4dp"
        android:paddingRight="6dp"
        android:textAppearance="@style/TextAppearance.App.Title"
        android:textColor="@color/item_v9pron_title_text_color"
        android:textStyle="bold"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iv_91mman_item_img" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_91mman_item_info"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:paddingBottom="8dp"
        android:textAppearance="@style/TextAppearance.App.Caption"
        android:textColor="@color/item_v9pron_info_text_color"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_91mman_item_title" />
</androidx.constraintlayout.widget.ConstraintLayout>
