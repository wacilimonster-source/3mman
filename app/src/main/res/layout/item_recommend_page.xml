<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <com.m3man.ui.recommend.RecoVideoPlayer
        android:id="@+id/reco_player"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="invisible" />

    <ImageView
        android:id="@+id/iv_reco_cover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/reco_cover"
        android:scaleType="centerCrop" />

    <ProgressBar
        android:id="@+id/pb_reco_loading"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_gravity="center" />

    <TextView
        android:id="@+id/tv_reco_error"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="#99000000"
        android:paddingBottom="8dp"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="8dp"
        android:text="@string/reco_parse_failed"
        android:textColor="#FFFFFFFF"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- 右侧操作栏 -->
    <LinearLayout
        android:id="@+id/ll_reco_actions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginBottom="40dp"
        android:layout_marginEnd="10dp"
        android:layout_marginRight="10dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/iv_reco_like"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:contentDescription="@string/reco_like"
            android:src="@drawable/ic_thumb_up_white_24dp" />

        <TextView
            android:id="@+id/tv_reco_like"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:shadowColor="#FF000000"
            android:shadowRadius="3"
            android:text="@string/reco_like"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp" />

        <ImageView
            android:id="@+id/iv_reco_favorite"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginTop="16dp"
            android:contentDescription="@string/reco_favorite"
            android:src="@drawable/ic_favorite_white_32dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:shadowColor="#FF000000"
            android:shadowRadius="3"
            android:text="@string/reco_favorite"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp" />

        <ImageView
            android:id="@+id/iv_reco_dislike"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginTop="16dp"
            android:contentDescription="@string/reco_dislike"
            android:src="@drawable/ic_thumb_down_white_24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:shadowColor="#FF000000"
            android:shadowRadius="3"
            android:text="@string/reco_dislike"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp" />

        <ImageView
            android:id="@+id/iv_reco_detail"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginTop="16dp"
            android:contentDescription="@string/reco_detail"
            android:src="@drawable/ic_slow_motion_video_black_24dp"
            android:tint="#FFFFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:shadowColor="#FF000000"
            android:shadowRadius="3"
            android:text="@string/reco_detail"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp" />

        <ImageView
            android:id="@+id/iv_reco_download"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginTop="16dp"
            android:contentDescription="@string/reco_download"
            android:src="@drawable/ic_file_download_black_24dp"
            android:tint="#FFFFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:shadowColor="#FF000000"
            android:shadowRadius="3"
            android:text="@string/reco_download"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- 底部可拖动进度条 + 时间 -->
    <LinearLayout
        android:id="@+id/ll_reco_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginBottom="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:layout_marginStart="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_reco_cur"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp" />

        <SeekBar
            android:id="@+id/sb_reco_progress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"
            android:layout_weight="1"
            android:max="1000"
            android:maxHeight="3dp"
            android:minHeight="3dp"
            android:paddingBottom="10dp"
            android:paddingTop="10dp"
            android:progress="0" />

        <TextView
            android:id="@+id/tv_reco_dur"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- 底部信息 -->
    <LinearLayout
        android:id="@+id/ll_reco_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginBottom="54dp"
        android:layout_marginEnd="76dp"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="76dp"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_reco_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:shadowColor="#FF000000"
            android:shadowRadius="4"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tv_reco_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:shadowColor="#FF000000"
            android:shadowRadius="4"
            android:textColor="#CCFFFFFF"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
