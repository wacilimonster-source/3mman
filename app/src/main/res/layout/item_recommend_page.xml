<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <com.m3man.ui.recommend.RecoVideoPlayer
        android:id="@+id/reco_player"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="invisible" />

    <ImageView
        android:id="@+id/iv_reco_cover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/reco_cover"
        android:scaleType="centerCrop" />

    <ProgressBar
        android:id="@+id/pb_reco_loading"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_gravity="center" />

    <!-- M112：错误态由「一行纯文字」升级为「文案 + 重试按钮」。
         此前只能靠文案末尾的「，点击重试」提示用户去点整块文字，
         没有任何按钮外观，用户根本不知道这里可点。 -->
    <LinearLayout
        android:id="@+id/ll_reco_error"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="#99000000"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingBottom="@dimen/space_4"
        android:paddingLeft="@dimen/space_4"
        android:paddingRight="@dimen/space_4"
        android:paddingTop="@dimen/space_4"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_reco_error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/reco_parse_failed"
            android:textAppearance="@style/TextAppearance.App.Inverse.Body" />

        <Button
            android:id="@+id/btn_reco_retry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3"
            android:minHeight="@dimen/touch_min"
            android:paddingLeft="@dimen/space_4"
            android:paddingRight="@dimen/space_4"
            android:text="@string/reco_retry"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- M78：双击快进反馈，显示实际跳过秒数 -->
    <TextView
        android:id="@+id/tv_reco_seek_feedback"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="#99000000"
        android:paddingBottom="10dp"
        android:paddingLeft="18dp"
        android:paddingRight="18dp"
        android:paddingTop="10dp"
        android:textColor="#FFFFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- M112：拖动进度条时的时间气泡。原实现拖动时只有左侧 tv_reco_cur 的小字在变，
         手指按住的位置没有任何反馈，很难对准目标时间点。 -->
    <TextView
        android:id="@+id/tv_reco_seek_bubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="96dp"
        android:background="#CC000000"
        android:gravity="center"
        android:minWidth="72dp"
        android:paddingBottom="@dimen/space_2"
        android:paddingLeft="@dimen/space_3"
        android:paddingRight="@dimen/space_3"
        android:paddingTop="@dimen/space_2"
        android:text="00:00"
        android:textColor="#FFFFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- M119：点赞（右栏按钮 / 左1/3 双击）时的心形爆流动效 -->
    <ImageView
        android:id="@+id/iv_reco_burst_heart"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_gravity="center"
        android:contentDescription="@string/reco_like"
        android:src="@drawable/ic_favorite_white_32dp"
        android:tint="#FFFF4D67"
        android:visibility="gone" />

    <!-- M119：右栏图标下方增加文字标签（竖屏显示，横屏由 applyOrientationUi 隐藏），
         解决"五个纯图标分不清赞/藏/踩"的发现性问题。点击标签等同点击图标。 -->
    <LinearLayout
        android:id="@+id/ll_reco_actions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginBottom="@dimen/reco_actions_margin_bottom"
        android:layout_marginEnd="@dimen/reco_actions_margin_end"
        android:layout_marginRight="@dimen/reco_actions_margin_end"
        android:paddingBottom="@dimen/reco_actions_padding_v"
        android:paddingLeft="@dimen/reco_actions_padding_h"
        android:paddingRight="@dimen/reco_actions_padding_h"
        android:paddingTop="@dimen/reco_actions_padding_v"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/iv_reco_mute"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:layout_marginBottom="4dp"
            android:contentDescription="@string/reco_mute"
            android:padding="@dimen/touch_padding_icon_36"
            android:src="@drawable/ic_reco_volume_white" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iv_reco_like"
                android:layout_width="@dimen/touch_min"
                android:layout_height="@dimen/touch_min"
                android:contentDescription="@string/reco_like"
                android:padding="@dimen/touch_padding_icon_36"
                android:src="@drawable/ic_thumb_up_white_24dp" />

            <TextView
                android:id="@+id/tv_reco_like_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="赞"
                android:textColor="#B3FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iv_reco_favorite"
                android:layout_width="@dimen/touch_min"
                android:layout_height="@dimen/touch_min"
                android:contentDescription="@string/reco_favorite"
                android:padding="@dimen/touch_padding_icon_36"
                android:src="@drawable/ic_favorite_white_32dp" />

            <TextView
                android:id="@+id/tv_reco_favorite_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="收藏"
                android:textColor="#B3FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iv_reco_dislike"
                android:layout_width="@dimen/touch_min"
                android:layout_height="@dimen/touch_min"
                android:contentDescription="@string/reco_dislike"
                android:padding="@dimen/touch_padding_icon_36"
                android:src="@drawable/ic_thumb_down_white_24dp" />

            <TextView
                android:id="@+id/tv_reco_dislike_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="不喜欢"
                android:textColor="#B3FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iv_reco_detail"
                android:layout_width="@dimen/touch_min"
                android:layout_height="@dimen/touch_min"
                android:contentDescription="@string/reco_detail"
                android:padding="@dimen/touch_padding_icon_36"
                android:src="@drawable/ic_slow_motion_video_black_24dp"
                android:tint="#FFFFFFFF" />

            <TextView
                android:id="@+id/tv_reco_detail_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="详情"
                android:textColor="#B3FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iv_reco_download"
                android:layout_width="@dimen/touch_min"
                android:layout_height="@dimen/touch_min"
                android:contentDescription="@string/reco_download"
                android:padding="@dimen/touch_padding_icon_36"
                android:src="@drawable/ic_file_download_black_24dp"
                android:tint="#FFFFFFFF" />

            <TextView
                android:id="@+id/tv_reco_download_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="下载"
                android:textColor="#B3FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 右缘半透明把手：开启「隐藏播放页操作栏」后用于临时呼出操作栏。
         M112：12dp → 24dp（原宽度手指几乎点不中） -->
    <View
        android:id="@+id/v_reco_handle"
        android:layout_width="@dimen/reco_handle_width"
        android:layout_height="72dp"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="4dp"
        android:layout_marginRight="4dp"
        android:background="#66000000"
        android:contentDescription="@string/reco_show_actions"
        android:visibility="gone" />

    <!-- 底部可拖动进度条 + 时间 -->
    <LinearLayout
        android:id="@+id/ll_reco_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginBottom="@dimen/reco_progress_margin_bottom"
        android:layout_marginEnd="@dimen/reco_progress_margin_right"
        android:layout_marginLeft="@dimen/reco_progress_margin_left"
        android:layout_marginRight="@dimen/reco_progress_margin_right"
        android:layout_marginStart="@dimen/reco_progress_margin_left"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_reco_cur"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textAppearance="@style/TextAppearance.App.Inverse.Caption" />

        <SeekBar
            android:id="@+id/sb_reco_progress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/space_2"
            android:layout_marginRight="@dimen/space_2"
            android:layout_weight="1"
            android:max="1000"
            android:maxHeight="@dimen/reco_seekbar_track"
            android:minHeight="@dimen/reco_seekbar_track"
            android:paddingBottom="12dp"
            android:paddingTop="12dp"
            android:progress="0" />

        <TextView
            android:id="@+id/tv_reco_dur"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textAppearance="@style/TextAppearance.App.Inverse.Caption" />

        <!-- M112：36dp+7dp padding → 48dp+6dp padding（视觉仍 36dp），
             与倍速按钮的间距由 4dp 提到 8dp，降低误触 -->
        <ImageView
            android:id="@+id/iv_reco_fullscreen"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:layout_marginLeft="@dimen/space_2"
            android:layout_marginStart="@dimen/space_2"
            android:contentDescription="@string/reco_fullscreen"
            android:padding="@dimen/touch_padding_icon_36"
            android:src="@drawable/ic_reco_fullscreen_white" />

        <!-- M112：宽度由 wrap_content（约 20dp）改为固定 48dp，达到触控下限；
             高度同样提到 48dp（原 36dp），gravity=center 保证 "1x" 仍居中显示 -->
        <TextView
            android:id="@+id/tv_reco_speed"
            android:layout_width="@dimen/reco_speed_width"
            android:layout_height="@dimen/touch_min"
            android:layout_marginLeft="@dimen/space_2"
            android:layout_marginStart="@dimen/space_2"
            android:clickable="true"
            android:contentDescription="@string/reco_speed"
            android:focusable="true"
            android:gravity="center"
            android:text="1x"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 底部信息 -->
    <LinearLayout
        android:id="@+id/ll_reco_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginBottom="54dp"
        android:layout_marginEnd="76dp"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="76dp"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_reco_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:shadowColor="#FF000000"
            android:shadowRadius="4"
            android:textAppearance="@style/TextAppearance.App.Inverse.Title" />

        <!-- M119：作者名独立可点（跳作者主页），时间信息跟在后面 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_reco_author"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:shadowColor="#FF000000"
                android:shadowRadius="4"
                android:textColor="#FFFF7A93"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_reco_meta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:layout_marginStart="6dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:shadowColor="#FF000000"
                android:shadowRadius="4"
                android:textAppearance="@style/TextAppearance.App.Inverse.Caption"
                android:textColor="#CCFFFFFF" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
