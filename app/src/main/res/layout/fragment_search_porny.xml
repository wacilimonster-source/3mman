<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/common_background"
    android:orientation="vertical">

    <android.support.v7.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?colorPrimary"
        app:titleTextColor="@color/common_always_white_text_color"
        app:popupTheme="@style/AppTheme.PopupOverlay"
        app:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar">

        <android.support.v7.widget.SearchView
            android:id="@+id/search_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </android.support.v7.widget.Toolbar>

    <!-- 内容区：列表 + 默认搜索提示（未搜索 / 无结果时居中展示，避免一进来太空） -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <android.support.v7.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/tv_search_hint"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:lineSpacingExtra="6dp"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:clickable="true"
            android:focusable="true"
            android:text="@string/search_hint_default"
            android:textColor="@color/common_black_white_text_color"
            android:textSize="14sp" />

        <!-- M44 搜索历史面板：未搜索时叠加在列表上 -->
        <include
            android:id="@+id/layout_search_history"
            layout="@layout/layout_search_history"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <!-- 底部页码跳转栏（与视频分类翻页交互一致，统一位于页面最底部） -->
    <include
        android:id="@+id/fl_skip_page"
        layout="@layout/layout_pron9_video_skip_page"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>
