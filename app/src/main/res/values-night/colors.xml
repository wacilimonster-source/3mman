    <color name="setting_list_separator_color">#343039</color>
    <!-- setting end-->
    <color name="bottom_navigation_bar_active">@color/brand</color>
    <color name="bottom_navigation_bar_inactive">#8A8494</color>
    <color name="bottom_navigation_bar_background">@color/bg_surface</color>
    <color name="floating_action_button_tine_bg_color">@color/qmui_config_color_gray_7</color>
    <color name="mine_header_text_color">@color/qmui_config_color_gray_7</color>
