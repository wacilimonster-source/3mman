    <!-- common start-->
    <color name="common_background">#111114</color>
    <color name="common_always_white_text_color">@color/qmui_config_color_gray_7</color>
    <color name="common_primary_white_text_color">@color/qmui_config_color_gray_7</color>
    <color name="common_black_white_text_color">@color/qmui_config_color_gray_7</color>
    <!-- common end-->

    <!-- 9 item start-->
    <color name="item_background">#19191E</color>
    <!-- 9 item end-->

    <!-- setting start-->
    <color name="setting_bg">#111114</color>
    <color name="setting_list_bg_normal">#19191E</color>
    <color name="setting_list_bg_pressed">#302239</color>
    <color name="setting_list_title_text_color">#F2EFF4</color>
