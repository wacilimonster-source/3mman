    <color name="item_3mman_comment_info_text_color">@color/qmui_config_color_gray_6</color>
    <color name="sort_category_drag_color">@color/colorPrimary</color>

    <!-- ==================== 语义色层（夜间对应值）====================
         必须与 values/colors.xml 中的语义 token 一一对应、成对维护。 -->
    <color name="bg_base">#111114</color>
    <color name="bg_surface">#19191E</color>
    <color name="bg_elevated">#19191E</color>

    <color name="text_primary">#F2EFF4</color>
    <color name="text_secondary">#C3BCCB</color>
    <color name="text_tertiary">#ADA6B6</color>
    <color name="text_inverse">#F2EFF4</color>

    <color name="brand">#D0A8EC</color>
    <!-- 顶部栏：夜间使用 bg_surface，避免 QMUI 默认灰色 #353C46 偏离 token。 -->
    <color name="toolbar_background">@color/bg_surface</color>
    <color name="toolbar_text">@color/text_primary</color>
    <color name="brand_container">#302239</color>
    <color name="on_brand">#25122F</color>
    <color name="accent">@color/colorAccent</color>

    <color name="state_error">#FF9BAB</color>

    <color name="divider">#343039</color>
    <color name="divider_strong">#443E4C</color>
    <!-- 系统状态栏：日间跟随品牌紫，夜间使用页面底色，避免白条截断深色页面。 -->
    <color name="status_bar_color">@color/bg_base</color>

    <!-- 18+ 身份标识：深色页面上也需要稳定可读，故不跟随主题反转。 -->
    <color name="identity_badge_border">#A34460</color>
    <color name="identity_badge_text">#E48AA3</color>
    <!-- 视频封面加载前占位（同尺寸、无闪烁）。 -->
    <color name="cover_placeholder">#26232C</color>
    <!-- 覆盖在视频/封面上的浮层与胶囊。 -->
    <color name="overlay_pill">#66000000</color>
    <!-- ==================== 语义色层 end ==================== -->
</resources>
