<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <com.m3man.ui.recommend.RecoVideoPlayer
        android:id="@+id/reco_player"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="invisible" />

    <ImageView
        android:id="@+id/iv_reco_cover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/reco_cover"
        android:scaleType="centerCrop" />

    <ProgressBar
        android:id="@+id/pb_reco_loading"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_gravity="center" />

    <TextView
        android:id="@+id/tv_reco_error"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="#99000000"
        android:paddingBottom="8dp"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="8dp"
        android:text="@string/reco_parse_failed"
        android:textColor="#FFFFFFFF"
        android:textSize="14sp"
        android:visibility="gone" />

    <!-- M78：双击快进反馈，显示实际跳过秒数 -->
    <TextView
        android:id="@+id/tv_reco_seek_feedback"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="#99000000"
        android:paddingBottom="10dp"
        android:paddingLeft="18dp"
        android:paddingRight="18dp"
        android:paddingTop="10dp"
        android:textColor="#FFFFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- 右侧操作栏（横屏专用）：为系统横屏安全区域预留右侧空间，避免按钮被裁切；间距收窄以适配宽屏。
         图标尺寸、文字显隐与竖屏完全统一，全部由静态 XML 决定，applyOrientationUi 只调整位置参数。 -->
    <LinearLayout
        android:id="@+id/ll_reco_actions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="112dp"
        android:layout_marginRight="112dp"
        android:paddingBottom="8dp"
        android:paddingLeft="6dp"
        android:paddingRight="6dp"
        android:paddingTop="8dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/iv_reco_like"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@string/reco_like"
            android:src="@drawable/ic_thumb_up_white_24dp" />

        <TextView
            android:id="@+id/tv_reco_like"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:shadowColor="#FF000000"
            android:shadowRadius="3"
            android:text="@string/reco_like"
            android:textColor="#FFFFFFFF"
            android:visibility="gone"
            android:textSize="11sp" />

        <ImageView
            android:id="@+id/iv_reco_favorite"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginTop="12dp"
            android:contentDescription="@string/reco_favorite"
            android:src="@drawable/ic_favorite_white_32dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:shadowColor="#FF000000"
            android:shadowRadius="3"
            android:text="@string/reco_favorite"
            android:textColor="#FFFFFFFF"
            android:visibility="gone"
            android:textSize="11sp" />

        <ImageView
            android:id="@+id/iv_reco_dislike"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginTop="12dp"
            android:contentDescription="@string/reco_dislike"
            android:src="@drawable/ic_thumb_down_white_24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:shadowColor="#FF000000"
            android:shadowRadius="3"
            android:text="@string/reco_dislike"
            android:textColor="#FFFFFFFF"
            android:visibility="gone"
            android:textSize="11sp" />

        <ImageView
            android:id="@+id/iv_reco_detail"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginTop="12dp"
            android:contentDescription="@string/reco_detail"
            android:src="@drawable/ic_slow_motion_video_black_24dp"
            android:tint="#FFFFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:shadowColor="#FF000000"
            android:shadowRadius="3"
            android:text="@string/reco_detail"
            android:textColor="#FFFFFFFF"
            android:visibility="gone"
            android:textSize="11sp" />

        <ImageView
            android:id="@+id/iv_reco_download"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginTop="12dp"
            android:contentDescription="@string/reco_download"
            android:src="@drawable/ic_file_download_black_24dp"
            android:tint="#FFFFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:shadowColor="#FF000000"
            android:shadowRadius="3"
            android:text="@string/reco_download"
            android:textColor="#FFFFFFFF"
            android:visibility="gone"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- 右缘半透明把手：开启「隐藏播放页操作栏」后用于临时呼出操作栏 -->
    <View
        android:id="@+id/v_reco_handle"
        android:layout_width="12dp"
        android:layout_height="72dp"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="4dp"
        android:layout_marginRight="4dp"
        android:background="#66000000"
        android:contentDescription="@string/reco_show_actions"
        android:visibility="gone" />

    <!-- 底部可拖动进度条 + 时间（横屏左右对称贴边，导航栏已隐藏） -->
    <LinearLayout
        android:id="@+id/ll_reco_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginBottom="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginStart="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_reco_cur"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp" />

        <SeekBar
            android:id="@+id/sb_reco_progress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"
            android:layout_weight="1"
            android:max="1000"
            android:maxHeight="3dp"
            android:minHeight="3dp"
            android:paddingBottom="10dp"
            android:paddingTop="10dp"
            android:progress="0" />

        <TextView
            android:id="@+id/tv_reco_dur"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp" />

        <ImageView
            android:id="@+id/iv_reco_fullscreen"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginLeft="4dp"
            android:layout_marginStart="4dp"
            android:contentDescription="@string/reco_fullscreen"
            android:padding="7dp"
            android:src="@drawable/ic_reco_fullscreen_white" />

        <TextView
            android:id="@+id/tv_reco_speed"
            android:layout_width="40dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:layout_marginLeft="2dp"
            android:layout_marginStart="2dp"
            android:paddingLeft="4dp"
            android:paddingRight="4dp"
            android:text="1x"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/reco_speed" />
    </LinearLayout>

    <!-- 底部信息（横屏贴边，并为右侧操作栏让出空间） -->
    <LinearLayout
        android:id="@+id/ll_reco_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginBottom="60dp"
        android:layout_marginEnd="80dp"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="80dp"
        android:layout_marginStart="16dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_reco_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:shadowColor="#FF000000"
            android:shadowRadius="4"
            android:textColor="#FFFFFFFF"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tv_reco_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:shadowColor="#FF000000"
            android:shadowRadius="4"
            android:textColor="#CCFFFFFF"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
