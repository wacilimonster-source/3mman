<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="QMUI.Compat.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>

        <!-- 配置app自己的theme -->

        <item name="app_content_bg_color">@color/qmui_config_color_white</item>
        <item name="QMUICommonListItemViewStyle">@style/myss</item>
        <item name="qmui_dialog_bg">@drawable/qmui_dialog_bg</item>
        <item name="qmui_bottom_sheet_list_item_text_appearance">@style/myItemStyle</item>
    </style>

    <style name="myItemStyle" parent="QMUITextAppearance.ListItem">
        <item name="android:textColor">@color/common_black_white_text_color</item>
    </style>

    <style name="myss" parent="QMUI.CommonListItemView">
        <item name="qmui_commonList_titleColor">@color/setting_list_title_text_color</item>
        <item name="qmui_commonList_detailColor">@color/setting_list_detail_text_color</item>
    </style>

    <style name="MyEditText" parent="Theme.AppCompat.Light">
        <item name="colorControlNormal">@color/qmui_config_color_gray_5</item>
        <item name="colorControlActivated">@color/colorPrimary</item>
    </style>

    <style name="MyCheckBox" parent="Theme.AppCompat.Light">
        <item name="colorControlNormal">@color/qmui_config_color_gray_5</item>
        <item name="colorControlActivated">@color/colorPrimary</item>
    </style>

    <style name="MyRadioButton" parent="Theme.AppCompat.Light">
        <item name="colorControlNormal">@color/qmui_config_color_gray_5</item>
        <item name="colorControlActivated">@color/colorPrimary</item>
    </style>

    <style name="MyDialogTheme" parent="Theme.AppCompat.Light.Dialog.Alert">
        <!--item RadioButton or CheckBox color-->
        <item name="colorControlNormal">@android:color/white</item>
        <item name="colorControlActivated">@color/colorPrimary</item>
        <!--item text color-->
        <item name="textColorAlertDialogListItem">@android:color/white</item>
        <!--buttons color-->
        <item name="colorAccent">@color/colorPrimary</item>
        <!--title and message color-->
        <item name="android:textColorPrimary">@color/common_black_white_text_color</item>
        <!--dialog background-->
        <item name="android:windowBackground">@drawable/background_dialog</item>
    </style>

    <!-- M79：推荐方向筛选专用高对比度弹窗，不影响其他共用 MyDialogTheme 的弹窗。 -->
    <style name="RecoOrientationDialogTheme" parent="Theme.AppCompat.Dialog.Alert">
        <item name="colorControlNormal">@color/common_black_white_text_color</item>
        <item name="colorControlActivated">@color/colorAccent</item>
        <item name="textColorAlertDialogListItem">@color/common_black_white_text_color</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:textColorPrimary">@color/common_black_white_text_color</item>
        <item name="android:textColorSecondary">@color/common_black_white_text_color</item>
        <item name="android:windowBackground">@drawable/background_dialog</item>
    </style>

    <style name="LoadingDialogStyle" parent="Theme.AppCompat.Dialog">
        <item name="android:windowBackground">@drawable/dialog_corner_bg</item>
    </style>

    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

    <style name="ToolbarTextAppearance">
        <item name="android:fontFamily">sans-serif-condensed</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:shadowDx">1</item>
        <item name="android:shadowDy">1</item>
        <item name="android:shadowRadius">2</item>
        <item name="android:shadowColor">?colorAccent</item>
    </style>

    <style name="ToolbarTextAppearance.Title">
        <item name="android:textSize">20sp</item>
    </style>

    <style name="ToolbarTextAppearance.Subtitle">
        <item name="android:textSize">14sp</item>
    </style>

    <style name="MyToolbar">
        <item name="theme">@style/ThemeOverlay.AppCompat.Dark</item>
        <item name="android:background">?colorPrimary</item>
    </style>

    <style name="AppFullScreenTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <style name="sort_category_popuwindow_anim" parent="android:Animation">
        <item name="android:windowEnterAnimation">@anim/pop_enter_anim</item>
        <item name="android:windowExitAnimation">@anim/pop_exit_anim</item>
    </style>

    <!-- ==================== 2026-11 体验精修 ==================== -->

    <!-- 筛选/选择胶囊：最小 48dp 热区，选中态背景+文字+边界同时变化。 -->
    <style name="Widget.App.Chip" parent="Widget.AppCompat.TextView">
        <item name="android:minHeight">@dimen/filter_chip_min_height</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:background">@drawable/bg_chip_choice</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Widget.App.PrimaryButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_primary_button</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">@color/primary_button_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Widget.App.SecondaryButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_secondary_button</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Widget.App.TextButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:textColor">@color/brand</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- 「更多」弹出菜单：跟随日/夜主题使用 bg_elevated + text_primary，
         避免深色页面弹出白色菜单。 -->
    <style name="AppTheme.PopupMenu" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:popupMenuStyle">@style/Widget.App.PopupMenu</item>
        <item name="popupMenuStyle">@style/Widget.App.PopupMenu</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <style name="Widget.App.PopupMenu" parent="Widget.AppCompat.PopupMenu">
        <item name="android:popupBackground">@color/bg_elevated</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- 底部筛选面板：顶部圆角 24dp；内容由布局自己画实色背景。 -->
    <style name="RecoFilterSheetTheme" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:colorBackground">@color/bg_surface</item>
        <item name="android:navigationBarColor">@color/bg_surface</item>
    </style>

</resources>
